geom_polygon(aes(fill=clusters)) +
coord_map() +
theme_void() + theme(legend.position = "none") +
scale_fill_gradientn(
colours = hcl.colors(10, "YlGnBu"), name="")+
ggtitle("Joint Regionalization of Log Median Income and Hospital Ratings")
